                </mxCell>
                <mxCell id="PQhnPlk2Px6ztPJdraVI-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="&lt;br&gt;const是写给编译器和读代码的人看的承诺。参数用 const&amp;amp;、不改对象的成员函数加 const、指针按&quot;从右往左&quot;读&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
